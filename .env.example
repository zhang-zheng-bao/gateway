# 网关配置示例 —— 复制为 .env 后按需修改
#
# 网关负责 TLS 终结与按域名转发，业务站点只需监听本机端口。

# 对外端口（80 用于健康检查，443 是真正的业务入口）
HTTP_PORT=80
HTTPS_PORT=443

# 证书目录（相对 gateway 项目根目录，也可写绝对路径）
CERT_DIR=certs

# 路由表：域名:本机端口，逗号分隔
# 新增站点时只需在此追加一条，无需改动任何业务代码
ROUTES=luzhougo.cn:3001,zhengbao.work:3002

# 未匹配到域名时的兜底端口（留空则返回 404）
DEFAULT_PORT=
